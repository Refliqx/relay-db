{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RelayDB",
  "version": "0.1.0",
  "identifier": "app.relaydb.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "RelayDB",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Portable DB sanitizer & seed builder",
    "longDescription": "RelayDB relays schema & data from MySQL, PostgreSQL, SQLite, and Turso into clean, masked .sql seed files that are safe to commit.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/relaydb-engine"
    ]
  }
}
